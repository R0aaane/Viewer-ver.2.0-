MEDIA_SERVER_HOST=127.0.0.1
MEDIA_SERVER_PORT=8000
MEDIA_SERVER_AUTH_TOKEN=
MEDIA_SERVER_MEDIA_ROOTS=\\\\PC\\share\\books;\\\\PC\\share\\images
MEDIA_SERVER_CORS_ORIGINS=http://127.0.0.1;http://localhost
MEDIA_SERVER_ALLOWED_NETWORKS=127.0.0.0/8;::1/128;100.64.0.0/10;fd7a:115c:a1e0::/48
MEDIA_SERVER_STARTUP_RESCAN=true
MEDIA_SERVER_LOG_LEVEL=INFO

# Optional generated-image importer. Set both host-local paths and a private
# MEDIA_SERVER_AUTH_TOKEN before enabling. The library must be new or empty.
# MEDIA_SERVER_COMFY_OUTPUT_DIR=D:\ComfyUI\output
# MEDIA_SERVER_GENERATED_LIBRARY_DIR=D:\GeneratedLibrary
## Optional ComfyUI generation. Register host-reviewed API workflows first.
# MEDIA_SERVER_COMFY_URL=http://127.0.0.1:8188
# MEDIA_SERVER_COMFY_PRESETS_PATH=E:/config/comfy-presets.json
MEDIA_SERVER_GENERATION_TIMEOUT_SECONDS=21600
